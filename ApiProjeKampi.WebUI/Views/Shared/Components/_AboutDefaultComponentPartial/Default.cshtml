@model List<ResultAboutDto>
@foreach (var item in Model.Take(1))
{
<section id="about" class="about section">
    <div class="container section-title"><h2>Hakkımızda</h2><p>@item.Title</p></div>
    <div class="container"><div class="row gy-4">
        <div class="col-lg-7"><img src="@item.ImageUrl" class="img-fluid mb-4" alt="@item.Title" />
            <div class="book-a-table"><h3>Rezervasyon</h3><p>@item.ReservationNumber</p></div>
        </div>
        <div class="col-lg-5"><div class="content ps-lg-5"><p style="white-space:pre-wrap">@item.Descrption</p>
            @if (!string.IsNullOrWhiteSpace(item.VideoCoverUrl)) { <img src="@item.VideoCoverUrl" class="img-fluid" alt="Mimmy restoranı" /> }
            @if (!string.IsNullOrWhiteSpace(item.VideoUrl)) { <a href="@item.VideoUrl" class="glightbox">Tanıtım videosunu izleyin</a> }
        </div></div>
    </div></div>
</section>
}
