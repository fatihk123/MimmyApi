@model List<ResultFeatureDto>
@foreach (var item in Model.DefaultIfEmpty(new ResultFeatureDto { Title = "Mimmy'ye Hoş Geldiniz", Description = "Lezzetli yemekler ve keyifli anlar.", ImageUrl = "/yummy-red-1.0.0/assets/img/hero-img.png" }).Take(1))
{
<section id="hero" class="hero section light-background">
    <div class="container"><div class="row gy-4 justify-content-center justify-content-lg-between">
        <div class="col-lg-5 order-2 order-lg-1 d-flex flex-column justify-content-center">
            <h1>@item.Title</h1><h2>@item.SubTitle</h2><p>@item.Description</p>
            <div class="d-flex"><a href="#book-a-table" class="btn-get-started">Rezervasyon Yapın</a>
                @if (!string.IsNullOrWhiteSpace(item.VideoUrl)) { <a href="@item.VideoUrl" class="glightbox btn-watch-video"><i class="bi bi-play-circle"></i> Videoyu İzleyin</a> }
            </div>
        </div>
        <div class="col-lg-5 order-1 order-lg-2 hero-img"><img src="@item.ImageUrl" class="img-fluid animated" alt="@item.Title" /></div>
    </div></div>
</section>
}
