@model List<ResultProductDto>
<div class="row gy-5">
    @if (Model.Count == 0) { <p class="text-center">Bu kategoride henüz ürün bulunmuyor.</p> }
    @foreach (var item in Model)
    {
        <div class="col-lg-4 menu-item">
            <a href="@item.ImageUrl" class="glightbox"><img src="@item.ImageUrl" class="menu-img img-fluid" alt="@item.ProductName" /></a>
            <h4>@item.ProductName</h4><p class="ingredients">@item.ProductDescription</p><p class="price">@item.Price.ToString("N2") ₺</p>
        </div>
    }
</div>
