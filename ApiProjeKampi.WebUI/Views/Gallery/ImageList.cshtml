@model List<ResultImageDto>
@{
    ViewData["Title"] = "Galeri";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<div class="card">
    <div class="card-header"><h4>Galeri</h4></div>
    <div class="card-body">
        <a asp-action="CreateImage" class="btn btn-primary mb-4">Yeni Görsel Ekle</a>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <img src="@item.ImageUrl" alt="@item.Title" style="width:100%;height:180px;object-fit:cover" />
                    <h5 class="mt-2">@item.Title</h5>
                    <a asp-action="UpdateImage" asp-route-id="@item.ImageId" class="btn btn-success">Güncelle</a>
                    <form asp-action="DeleteImage" asp-route-id="@item.ImageId" method="post" class="d-inline"><button class="btn btn-danger">Sil</button></form>
                </div>
            }
        </div>
    </div>
</div>
