@model GetMessageByIdDto
@{
    ViewData["Title"] = "Müşteri Mesajı";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<div class="card">
    <div class="card-header"><h4>@Model.Subject</h4></div>
    <div class="card-body">
        <p><strong>@Model.NameSurname</strong> · @Model.Email</p>
        <div style="white-space:pre-wrap">@Model.MessageDetails</div>
        <form asp-action="AnswerMessageWithOpenAI" asp-route-id="@Model.MessageId" method="post" class="mt-3">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <button class="btn btn-primary">Yapay Zekâ ile Yanıt Taslağı Hazırla</button>
            <a asp-action="MessageList" class="btn btn-light">Listeye Dön</a>
        </form>
        @if (ViewBag.Answer is string answer)
        {
            <hr />
            <h5>Yanıt taslağı</h5>
            <div style="white-space:pre-wrap">@answer</div>
            <p class="text-muted mt-3">Bu taslak müşteriye gönderilmedi. Göndermeden önce kontrol edin.</p>
        }
    </div>
</div>
