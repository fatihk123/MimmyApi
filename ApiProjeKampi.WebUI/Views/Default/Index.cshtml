@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

    @await Component.InvokeAsync("_HeadDefaultComponentPartial")

<body class="index-page">

    @await Component.InvokeAsync("_NavbarDefaultComponentPartial")

    <main class="main">

        <!-- Hero Section -->
        @await Component.InvokeAsync("_FeatureDefaultComponentPartial")


        <!-- /Hero Section -->
        <!-- About Section -->
        @await Component.InvokeAsync("_AboutDefaultComponentPartial")



        <!-- /About Section -->
        <!-- Why Us Section -->
        @await Component.InvokeAsync("_ServiceDefaultComponentPartial")

        <!-- /Why Us Section -->
        <!-- Stats Section -->

        @await Component.InvokeAsync("_HomePageStatisticsComponentPartial")

        <!-- /Stats Section -->
        <!-- Menu Section -->
        @await Component.InvokeAsync("_DefaultMenuViewComponentPatrial")


        <!-- /Menu Section -->
        <!-- Testimonials Section -->
        @await Component.InvokeAsync("_TestimonialDefaultComponentPartial")
       

        <!-- /Testimonials Section -->
        <!-- Events Section -->
        @await Component.InvokeAsync("_MimmyEventDefaultComponentPartial")


        <!-- /Events Section -->
        <!-- Chefs Section -->
        @await Component.InvokeAsync("_ChefDefaultComponentPartial")

        <!-- /Chefs Section -->
        <!-- Rezervasyon Section -->
        <section id="book-a-table" class="book-a-table section">

            <!-- Section Title -->
            <div class="container section-title" data-aos="fade-up">
                <h2>Rezervasyon</h2>
                <p><span>Sofranızı</span> <span class="description-title">Ayırtın<br></span></p>
            </div><!-- End Section Title -->

            <div class="container">

                <div class="row g-0" data-aos="fade-up" data-aos-delay="100">

                    <div class="col-lg-4 reservation-img" style="background-image: url(/yummy-red-1.0.0/assets/img/reservation.jpg);"></div>

                    <div class="col-lg-8 d-flex align-items-center reservation-form-bg" data-aos="fade-up" data-aos-delay="200">
                        <form action="/Default/BookTable" method="post" role="form" class="php-email-form">
                            @Html.AntiForgeryToken()
                            <div class="row gy-4">
                                <div class="col-lg-4 col-md-6">
                                    <input type="text" name="NameSurname" class="form-control" id="name" placeholder="Adınız ve soyadınız" required="">
                                </div>
                                <div class="col-lg-4 col-md-6">
                                    <input type="email" class="form-control" name="Email" id="email" placeholder="E-posta adresiniz" required="">
                                </div>
                                <div class="col-lg-4 col-md-6">
                                    <input type="text" class="form-control" name="PhoneNumber" id="phone" placeholder="Telefon numaranız" required="">
                                </div>
                                <div class="col-lg-4 col-md-6">
                                    <input type="date" name="ReservationDate" class="form-control" id="date" placeholder="Date" required="">
                                </div>
                                <div class="col-lg-4 col-md-6">
                                    <input type="time" class="form-control" name="ReservationTime" id="time" placeholder="Time" required="">
                                </div>
                                <div class="col-lg-4 col-md-6">
                                    <input type="number" class="form-control" name="CountofPeople" min="1" max="50" id="people" placeholder="Kişi sayısı" required="">
                                </div>
                            </div>

                            <div class="form-group mt-3">
                                <textarea class="form-control" name="Message" rows="5" placeholder="Eklemek istediğiniz not"></textarea>
                            </div>

                            <div class="text-center mt-3">
                                <div class="loading">Gönderiliyor…</div>
                                <div class="error-message"></div>
                                <div class="sent-message">Rezervasyon talebiniz alındı. Onay için sizinle iletişime geçeceğiz. Teşekkür ederiz!</div>
                                <button type="submit">Rezervasyon Yap</button>
                            </div>
                        </form>
                    </div><!-- End Reservation Form -->

                </div>

            </div>

        </section><!-- /Rezervasyon Section -->
        <!-- Gallery Section -->
        @await Component.InvokeAsync("_DefaultGalleryComponentPartial")<!-- /Gallery Section -->
        <!-- Contact Section -->
        @await Component.InvokeAsync("_DefaultContactComponentPartial")<!-- /Contact Section -->

    </main>
   @await Component.InvokeAsync("_FooterDefaultComponentPartial")   

</body>

</html>
