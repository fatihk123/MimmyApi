@model List<ResultReservationDto>
@{
    ViewData["Title"] = "ReservationList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}


<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Rezervasyon Listesi</h4>
                    </div>
                    <div class="card-body">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Rezervasyon Sahibi</th>
                                    <th scope="col">Rezervasyon Tarihi</th>
                                    <th scope="col">Rezervasyon Durumu</th>
                                    <th scope="col">Telefon Numarası</th>
                                    <th scope="col">Rez Saat</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                    <th scope="col">Onayla</th>
                                    <th scope="col">İptal Et</th>
                                    <th scope="col">Beklet</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <th scope="row">@count</th>
                                        <td>@item.NameSurname</td>
                                        <td>@item.ReservationDate.ToString("yyyy-MM-dd")</td>
                                        <td>@item.ReservationStatus</td>
                                        <td>@item.PhoneNumber</td>
                                        <td>@item.ReservationTime</td>
                                        <td><form action="/Reservation/DeleteReservation/@item.ReservationID/" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Sil</button></form></td>
                                        <td><a href="/Reservation/UpdateReservation/@item.ReservationID/" class="btn btn-primary">Güncelle</a></td>
                                        <td><a href="/Reservation/AcceptReservation/@item.ReservationID/" class="btn btn-success">Onayla</a></td>
                                        <td><a href="/Reservation/CancelReservation/@item.ReservationID/" class="btn btn-danger">İptal Et</a></td>
                                        <td><a href="/Reservation/WaitReservation/@item.ReservationID/" class="btn btn-warning">Beklet</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>


            </div>

        </div>
    </div>
</section>
