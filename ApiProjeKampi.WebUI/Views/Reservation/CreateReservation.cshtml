@model CreateReservationDto
@{
    ViewData["Title"] = "CreateReservation";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Rezervasyon Oluşturma Sayfası</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
                            @Html.AntiForgeryToken()

                            <label>Misafir Adı & Soyadı</label>
                            <input type="text" asp-for="NameSurname" class="form-control" />
                            <br />
                            <label>E-Mail</label>
                            <input type="email" asp-for="Email" class="form-control" />
                            <br />
                            <label>Telefon No</label>
                            <input type="tel" asp-for="PhoneNumber" class="form-control" />
                            <br />
                            <label>Rezervasyon Tarihi</label>
                            <input type="date" asp-for="ReservationDate"  class="form-control" />
                            <br />
                            <label>Rezervasyon Saati</label>
                            <input type="time" asp-for="ReservationTime" step="60"  class="form-control" />
                            <br />
                            <label>Kişi Sayısı</label>
                            <input type="number" asp-for="CountofPeople" class="form-control" />
                            <br />
                            <label>Rezervasyon Mesajı</label>
                            <input type="text" asp-for="Message" class="form-control" />
                            <br />
                            <label>Rezervasyon Durumu</label>
                            <select asp-for="ReservationStatus" class="form-control"><option>Beklemede</option><option>Onaylandı</option><option>İptal Edildi</option></select>
                            <br />
                            <button class="btn btn-primary">Rezervasyon Oluştur</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
