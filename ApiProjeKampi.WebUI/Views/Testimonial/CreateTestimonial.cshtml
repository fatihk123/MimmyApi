@model CreateTestimonialDto

@{
    ViewData["Title"] = "CreateTestimonial";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Referans Ekleme Sayfası</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
                            @Html.AntiForgeryToken()
                            <label>Kategori Adı</label>
                            <input type="text" asp-for="NameSurName" class="form-control" />
                            <br />
                             <label>Başlık</label>
                            <input type="text" asp-for="Title" class="form-control" />
                            <br />
                            <label>Yorum</label>
                            <input type="text" asp-for="Comment" class="form-control" />
                            <br />
                            <label>Göresel (URL)</label>
                            <input type="text" asp-for="ImageUrl" class="form-control" />
                            <br />
                            <button class="btn btn-primary">Referans Ekle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
