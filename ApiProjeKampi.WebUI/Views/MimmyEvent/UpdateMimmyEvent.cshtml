@model UpdateMimmyEventDtos

@{
    ViewData["Title"] = "UpdateMimmyEvent";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Etkinlik Güncelleme Sayfası</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div asp-validation-summary="All" class="text-danger"></div>
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="MimmyEventId" />
                            <label>Etkinlik Adı</label>
                            <input type="text" asp-for="Title" class="form-control" />
                            <br />
                            <label>Etkinlik Açıklaması</label>
                            <input type="text" asp-for="Description" class="form-control" />
                            <br />
                            <label>Göresel (URL)</label>
                            <input type="text" asp-for="ImageUrl" class="form-control" />
                            <br />
                            <label>Etkinlik Fiyatı</label>
                            <input type="text" asp-for="Price" class="form-control" />
                            <br />
                            <button class="btn btn-success">Etkinlik Güncelle</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
