@model UpdateFeatureDto
@{
    ViewData["Title"] = "UpdateFeature";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Başlık Güncelleme Sayfası</h4>
                    </div>
                    <div class="card-body">

                        <form method="post" asp-action="UpdateFeature">
                            <input type="hidden" asp-for="FeatureId" />

                            <div class="form-group">
                                <label>Başlık</label>
                                <input type="text" asp-for="Title" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Alt Başlık</label>
                                <input type="text" asp-for="SubTitle" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Açıklama</label>
                                <input type="text" asp-for="Description" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label>Resim Yolu (URL)</label>
                                <input type="text" asp-for="ImageUrl" class="form-control" />
                            </div>

                            <div class="form-group">
                                <label>Video Yolu (URL)</label>
                                <input type="text" asp-for="VideoUrl" class="form-control" />
                            </div>

                            <br />
                            <button type="submit" class="btn btn-warning">
                                Güncelle
                            </button>

                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
